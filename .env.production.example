# Copie para .env.production (na raiz do projeto) antes do docker compose.

# OBRIGATÓRIA. Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Guarde-a: se mudar, as chaves salvas no sistema precisam ser cadastradas de novo.
BT_SECRET_KEY=

# true quando acessado por HTTPS (perfil "https" com Caddy ou outro proxy com TLS)
BT_COOKIE_SECURE=true

BT_ALLOW_REGISTRATION=false
BT_ENGINE_POLL_SECONDS=15
BT_AI_MODEL=claude-opus-5
BT_AI_FAST_MODEL=claude-haiku-4-5
# Notícias, medo e ganância e piloto automático (tarefas em segundo plano)
BT_SCHEDULER_ENABLED=true
BT_NEWS_ENABLED=true
# BT_ANTHROPIC_API_KEY=   (opcional; pode ser cadastrada pela interface)

# Domínio para o Caddy (perfil https), ex.: bot.seudominio.com
DOMAIN=
