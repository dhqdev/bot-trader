# Copie para backend/.env (uso local) ou defina no docker-compose / servidor.
# Todas as variáveis usam o prefixo BT_.

# development | production
BT_ENV=development

# Obrigatória em produção. Assina a sessão de login e criptografa as chaves
# salvas no banco. Se mudar, as chaves da Binance/Anthropic precisam ser
# cadastradas de novo. Gere com:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Em desenvolvimento, se ficar vazia, é gerada e salva em backend/data/.secret_key
BT_SECRET_KEY=

# Banco de dados (padrão: SQLite em backend/data/bot_trader.db)
# BT_DATABASE_URL=sqlite:///C:/caminho/bot_trader.db

# Permite novos cadastros depois do primeiro usuário (padrão: não)
BT_ALLOW_REGISTRATION=false

# Use true quando o sistema estiver atrás de HTTPS (produção)
BT_COOKIE_SECURE=false

# Frequência (s) com que cada bot confere preço, stop e alvos
BT_ENGINE_POLL_SECONDS=15

# IA: a chave também pode ser cadastrada pela interface (Configurações)
BT_ANTHROPIC_API_KEY=
BT_AI_MODEL=claude-opus-5
